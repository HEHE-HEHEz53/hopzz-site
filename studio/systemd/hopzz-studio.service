[Unit]
Description=Hopzz Studio (studio.hopzz.top)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/hopzz-studio/server
EnvironmentFile=/opt/hopzz-studio/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/hopzz-studio/venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8103 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/files /opt/hopzz-studio/data

[Install]
WantedBy=multi-user.target
