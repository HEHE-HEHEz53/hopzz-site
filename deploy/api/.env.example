# =====================================================================
# hopzz-api 环境变量样例
#
# 真实文件在服务器：/opt/hopzz-api/.env（600，root:root 或 www-data）
# 这个样例可以入库，但绝不能填真实值。
# =====================================================================

# ---- 基础 ----
# 数据库路径（www-data 需要可写）
DB_PATH=/opt/hopzz-api/data/hopzz.db
# ESP32 上报用的设备令牌，必须是随机长串
DEVICE_TOKEN=

# ---- 赞助（一人付 opcpay）----
# 本地 Node 桥服务地址；桥只监听 127.0.0.1，Key 只在 /opt/opcpay-bridge/.env
BRIDGE_URL=http://127.0.0.1:8102

# 可选：页面回跳地址。必须 HTTPS，且域名与一人付项目登记的官网一致。
# 不确定就留空（不传 callback_url）；前端靠切回页面时重新查 /access 来确认。
SPONSOR_CALLBACK_URL=

# 可选：隐藏一人付控制台里的测试商品，逗号分隔的 SKU id（来自 /product 真实返回）。
# 例：SPONSOR_HIDDEN_SKUS=S0806000213861216
SPONSOR_HIDDEN_SKUS=

# 匿名赞助者 Cookie 是否要求 HTTPS（线上是 HTTPS，保持 1；本地 http 调试才设 0）
COOKIE_SECURE=1

# 可选：Cookie HMAC 密钥文件；不配则用 <DB_PATH 所在目录>/.uid_secret（自动生成，600）
# UID_SECRET_PATH=/opt/hopzz-api/data/.uid_secret
